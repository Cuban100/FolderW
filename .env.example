# Copy this file to .env and fill in your values, or run setup.py to
# generate it through the Tkinter configuration GUI.

# Directory to back up
SRC_DIR=/path/to/source

# Directory where backups are stored
BASE_DIR=/path/to/backup/destination

# SQLite database file used to track changes/sessions
DATABASE=backup.db

# The full (mirror) backup always lives at BASE_DIR/Full Backup, and
# incremental snapshots at BASE_DIR/Snapshots/Months/<Month>/<Day>/<Time> —
# not configurable.

# Port the FastAPI dashboard (server.py) listens on
SERVER_PORT=8000

# 1 = watch SRC_DIR continuously with watchdog and back up on change
# 0 = back up on a fixed schedule instead (see BACKUP_INTERVAL)
MONITOR=0

# Used only when MONITOR=0. One of: hourly, half-day, daily, weekly
BACKUP_INTERVAL=hourly

# 1 = install/enable a systemd --user service that starts server.py on boot/login
# 0 = don't manage a systemd service (Linux only, see setup.py)
AUTOSTART=0

# Max number of incremental snapshots to keep under BASE_DIR/Snapshots/Months.
# Oldest snapshots beyond this count are deleted automatically after each
# backup. Never affects the full backup. Leave blank to keep every snapshot
# forever.
MAX_SNAPSHOTS=
