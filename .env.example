# Copy this file to .env and fill in your values, or run setup.py to
# generate it through the Tkinter configuration GUI.

# Dashboard UI language: en (English) or es (Español). Switch instantly
# from the EN | ES control in the page footer, or set it here directly --
# either way takes effect on the next page load, no restart needed.
# Blank or unrecognized values fall back to English.
LANGUAGE=en

# Dashboard appearance: dark or light. Switch instantly from Settings'
# Appearance section, or set it here directly -- either way takes effect
# on the next page load, no restart needed. Blank or unrecognized values
# fall back to dark (how every install looked before this setting
# existed).
THEME=dark

# Directory to back up
SRC_DIR=/path/to/source

# Directory where backups are stored
BASE_DIR=/path/to/backup/destination

# SQLite database file used to track changes/sessions
DATABASE=backup.db

# Name of the folder created inside BASE_DIR to hold the backup. The full
# (mirror) backup lives at BASE_DIR/FULL_NAME/Full Backup, and incremental
# snapshots at BASE_DIR/FULL_NAME/Snapshots/Months/<Month>/<Day>/<Time>.
FULL_NAME=Documents

# Port the FastAPI dashboard (server.py) listens on
SERVER_PORT=8000

# 1 = watch SRC_DIR continuously with watchdog and back up on change
# 0 = back up on a fixed schedule instead (see BACKUP_INTERVAL)
MONITOR=0

# Used only when MONITOR=0. One of: hourly, half-day, daily, weekly
BACKUP_INTERVAL=hourly

# 1 = install/enable a systemd --user service that starts server.py on boot/login
# 0 = don't manage a systemd service (Linux only, see setup.py)
AUTOSTART=0

# Max number of incremental snapshots to keep under
# BASE_DIR/FULL_NAME/Snapshots/Months. Oldest snapshots beyond this count are
# deleted automatically after each backup. Never affects the full backup.
# Leave blank to keep every snapshot forever.
MAX_SNAPSHOTS=

# Salted PBKDF2 hash of the dashboard login password (never the plaintext
# password itself). Leave blank to disable login entirely. Set via the web
# Settings page or setup.py — not meant to be edited by hand.
ADMIN_PASSWORD_HASH=

# Signs session cookies; auto-generated on first run if left blank. Do not
# share this value — anyone with it can forge a valid login cookie.
SECRET_KEY=

# Comma-separated Apprise URLs (https://github.com/caronc/apprise) —
# e.g. pover://user@token for Pushover, ntfy://topic for ntfy. Notified on
# backup failure and full backup completion. Leave blank to disable.
NOTIFY_URLS=

# 1 = after every successful local backup, mirror SRC_DIR itself to an
# rclone remote (current state only, not the local Snapshot history). 0 =
# don't. Requires rclone (https://rclone.org) installed and at least one
# remote already configured — via the setup wizard's Cloud Backup
# section, the dashboard's Cloud Backup page, or `rclone config`
# directly. FolderW never handles cloud credentials/OAuth itself, only
# shells out to rclone.
CLOUD_SYNC_ENABLED=0

# Name of an existing rclone remote (see `rclone listremotes`). Set from
# the setup wizard or the Cloud Backup page's dropdown — not meant to be
# edited by hand. The destination folder inside the remote is always
# basename(SRC_DIR), computed automatically -- not a separate setting.
CLOUD_SYNC_REMOTE=

# Optional rclone --bwlimit value (e.g. 10M). Leave blank for unlimited.
CLOUD_SYNC_BWLIMIT=
