# Copy this file to .env and fill in your values, or run setup.py to
# generate it through the Tkinter configuration GUI.

# Directory to back up
SRC_DIR=/path/to/source

# Directory where backups are stored
BASE_DIR=/path/to/backup/destination

# SQLite database file used to track changes/sessions
DATABASE=backup.db

# Name of the subfolder under BASE_DIR that holds the full (mirror) backup
FULL_NAME=FULL

# Port the FastAPI dashboard (server.py) listens on
SERVER_PORT=8000

# 1 = watch SRC_DIR continuously with watchdog and back up on change
# 0 = back up on a fixed schedule instead (see BACKUP_INTERVAL)
MONITOR=0

# Used only when MONITOR=0. One of: hourly, half-day, daily, weekly
BACKUP_INTERVAL=hourly
